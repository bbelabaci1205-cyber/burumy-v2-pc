            </intent-filter>
        </activity-alias>
        <!-- App icon "logo_lineb" (Settings > Appearance > App icon; Burumy v1 art). -->
        <activity-alias
            android:name=".IconLogo_lineb"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_logo_lineb"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
